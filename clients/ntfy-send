#!/bin/sh
# ntfy-send - POSIX sh, works on Linux and OPNsense/FreeBSD (needs curl).
# Publishes via the router failover proxy. No spool: if the router or both servers
# are down, the message is lost and the exit code is non-zero.
#
#   ntfy-send [-t title] [-p priority] [-g tags] [-c click-url] [-m] <topic> <message|->
#     -m  markdown;  message "-" reads stdin
#
# Config: env file at /etc/ntfy-send.conf (or $NTFY_SEND_CONF):
#   NTFY_URL=http://192.168.1.1:8080
#   NTFY_TOKEN=tk_...
set -u
CONF=${NTFY_SEND_CONF:-/etc/ntfy-send.conf}
[ -r "$CONF" ] && . "$CONF"
: "${NTFY_URL:?NTFY_URL not set (see $CONF)}" "${NTFY_TOKEN:?NTFY_TOKEN not set}"

title= prio= tags= click= md=
while getopts t:p:g:c:m o; do
  case $o in
    t) title=$OPTARG ;; p) prio=$OPTARG ;; g) tags=$OPTARG ;; c) click=$OPTARG ;; m) md=yes ;;
    *) echo "usage: $0 [-t title] [-p prio] [-g tags] [-c url] [-m] topic message" >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))

topic=${1:?topic required}; msg=${2:?message required (or - for stdin)}
[ "$msg" = "-" ] && msg=$(cat)

set -- -fsS --connect-timeout 3 -m 15 -o /dev/null -H "Authorization: Bearer $NTFY_TOKEN" --data-binary "$msg"
[ -n "$title" ] && set -- "$@" -H "Title: $title"
[ -n "$prio" ]  && set -- "$@" -H "Priority: $prio"
[ -n "$tags" ]  && set -- "$@" -H "Tags: $tags"
[ -n "$click" ] && set -- "$@" -H "Click: $click"
[ -n "$md" ]    && set -- "$@" -H "Markdown: yes"
curl "$@" "${NTFY_URL%/}/$topic" || { logger -t ntfy-send "failed [$topic] ${title:+$title: }$msg" 2>/dev/null; exit 1; }
