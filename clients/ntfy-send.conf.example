# /etc/ntfy-send.conf  (chmod 600) - env file, shell syntax.
# Router failover proxy; on OPNsense itself use http://127.0.0.1:8080.
NTFY_URL=http://192.168.1.1:8080
# This machine's publisher token from clients.env.
NTFY_TOKEN=tk_...
# Where undeliverable messages wait for `ntfy-send -f`.
NTFY_SPOOL=/var/spool/ntfy-send
