# Router failover proxy settings - committed, no secrets (tokens pass through untouched).

# Where senders connect: http://<router-ip>:8080 (or a DNS name like ntfy.lan pointing at it).
PROXY_LISTEN=:8080

# Primary: the VPS (HTTPS, port 443).
NTFY_VPS_HOST=ntfy.example.com
# Backup: the home ntfy server.
NTFY_HOME_ADDR=192.168.1.10:8080

# Health check interval; the VPS is marked down after 2 failures.
CHECK_INTERVAL=5s

# CA bundle for verifying the VPS certificate (path inside the haproxy container / host).
CA_FILE=/etc/ssl/certs/ca-certificates.crt
