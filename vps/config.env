# VPS stack settings - committed. Secrets live in secrets.env (gitignored).

# Public URL; Caddy gets a TLS certificate for this host automatically.
NTFY_BASE_URL=https://ntfy.example.com

NTFY_LISTEN_HTTP=:80
NTFY_BEHIND_PROXY=true

NTFY_CACHE_FILE=/var/cache/ntfy/cache.db
NTFY_CACHE_DURATION=24h
NTFY_ATTACHMENT_CACHE_DIR=/var/cache/ntfy/attachments

NTFY_AUTH_FILE=/var/lib/ntfy/user.db
NTFY_AUTH_DEFAULT_ACCESS=deny-all
NTFY_ENABLE_LOGIN=true
NTFY_ENABLE_SIGNUP=false

# ACLs (users + tokens are in secrets.env). Admin users need no entries.
NTFY_AUTH_ACCESS=publisher:*:wo,backfill:*:wo

# Rate limits are per client IP, and all your home senders share one WAN IP.
# Raise them (all access needs a token anyway). If your WAN IP is static, also set
# NTFY_VISITOR_REQUEST_LIMIT_EXEMPT_HOSTS=<that IP>.
NTFY_VISITOR_REQUEST_LIMIT_BURST=1000
NTFY_VISITOR_REQUEST_LIMIT_REPLENISH=1s

# Instant delivery for the iOS app on a self-hosted server (only a poll hint goes to ntfy.sh).
NTFY_UPSTREAM_BASE_URL=https://ntfy.sh
