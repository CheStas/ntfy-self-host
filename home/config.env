# Home stack settings - committed. Secrets live in secrets.env (gitignored).
# The home server only receives messages when the router proxy can't reach the VPS.

# LAN URL of this server (port must match the published port in docker-compose.yml).
NTFY_BASE_URL=http://192.168.1.10:8080

NTFY_LISTEN_HTTP=:80
# Long cache: messages stay available for backfill to the VPS after a long outage.
NTFY_CACHE_FILE=/var/cache/ntfy/cache.db
NTFY_CACHE_DURATION=72h
NTFY_ATTACHMENT_CACHE_DIR=/var/cache/ntfy/attachments

NTFY_AUTH_FILE=/var/lib/ntfy/user.db
NTFY_AUTH_DEFAULT_ACCESS=deny-all
NTFY_ENABLE_LOGIN=true
NTFY_ENABLE_SIGNUP=false
NTFY_AUTH_ACCESS=publisher:*:wo,backfill:*:rw

# Rate limits are per client IP. Behind the router proxy every sender shares the router's IP,
# so exempt it, and raise the limit for everything else (all access needs a token anyway).
NTFY_VISITOR_REQUEST_LIMIT_EXEMPT_HOSTS=192.168.1.1
NTFY_VISITOR_REQUEST_LIMIT_BURST=1000
NTFY_VISITOR_REQUEST_LIMIT_REPLENISH=1s

# --- backfill: copies what landed here to the VPS once it's reachable again ---
BACKFILL_LOCAL_URL=http://ntfy:80
BACKFILL_VPS_URL=https://ntfy.example.com
# Topics to backfill (the same names your senders use).
BACKFILL_TOPICS=homeassistant,opnsense,servers
# Priority of the delayed copies on the VPS: 2 = silent, appears in history. 0 = don't backfill.
BACKFILL_PRIORITY=2
# Status notices ("VPS unreachable" here, "reachable again" on the VPS).
BACKFILL_STATUS_TOPIC=relay
BACKFILL_NOTICE_AFTER=30
BACKFILL_HEALTH_INTERVAL=15
BACKFILL_POLL_INTERVAL=5
# Used for the "[delayed HH:MM]" title prefix. The Alpine image has no tz database,
# so use a POSIX TZ string, e.g. CET-1CEST,M3.5.0,M10.5.0/3 for Central Europe.
TZ=UTC0
